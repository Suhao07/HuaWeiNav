  <diagram id="0" name="01 实物系统框架">
    <mxGraphModel dx="1920" dy="1380" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1380" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="STRIVE-Nav 实物系统｜主要模块与输入输出&lt;br&gt;依据当前 ROS2 入口与接口代码绘制 · 2026-10-27 · 表示代码连接关系，设备状态需现场验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0ebf5;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=28;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1860" height="105" as="geometry" />
        </mxCell>
        <mxCell id="sensor" value="传感器与标定&lt;br&gt;RGB / CameraInfo / LiDAR / IMU&lt;br&gt;输出：带时间戳的传感器消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fa;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="160" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="lio" value="定位与点云注册 / Point-LIO&lt;br&gt;输入：LiDAR + IMU&lt;br&gt;输出：注册点云、Odometry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fa;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="160" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="det" value="检测 / 分割 / 跟踪&lt;br&gt;输入：RGB + 检测词表&lt;br&gt;输出：/detection_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fa;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="790" y="160" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="map" value="SysNav 语义建图&lt;br&gt;输入：检测 + 点云 + 位姿&lt;br&gt;输出：对象节点；房间为可选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fa;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1170" y="160" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="snap" value="ROS adapters / MapBridge&lt;br&gt;输入：对象、房间、位姿、视点&lt;br&gt;输出：SemanticMapSnapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fa;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1550" y="160" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="user" value="用户指令&lt;br&gt;输入：自然语言任务&lt;br&gt;输出：instruction 字符串" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ef;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="compile" value="指令编译 / 任务合同&lt;br&gt;输入：instruction&lt;br&gt;输出：InstructionPlan / TaskSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ef;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="实物高层编排&lt;br&gt;SysNavInstructionRuntime&lt;br&gt;策略：SemanticMapSnapshot&lt;br&gt;输出：NavigationIntent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ef;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="790" y="470" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="SysNavGoalResolver&lt;br&gt;输入：target / anchor + 视点&lt;br&gt;输出：MotionGoal / ViewpointGoal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ef;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1170" y="470" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="motion" value="MotionSupervisor / ROS 后端&lt;br&gt;输入：唯一活动 MotionGoal&lt;br&gt;输出：提交、取消、HOLD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ef;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1550" y="470" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="RosObservationCache&lt;br&gt;输入：RGB / 深度或点云 / 位姿&lt;br&gt;输出：可追溯观测记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="800" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="EvidenceProvider / 取证&lt;br&gt;输入：到达事件 + 新鲜观测&lt;br&gt;输出：ViewEvidence / crop / pose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="800" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="关系 / 最终视觉验证&lt;br&gt;输入：任务 + 证据 + 几何&lt;br&gt;输出：accept / reject / 补拍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="790" y="800" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="status" value="NavigationStatusProvider&lt;br&gt;输入：odom / path / 控制状态&lt;br&gt;输出：RUNNING / REACHED&lt;br&gt;BLOCKED / CANCELLED 等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1170" y="800" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="lower" value="SysNav 下层规划与跟踪&lt;br&gt;输入：/way_point 或 Action 服务&lt;br&gt;输出：路径 / 跟踪速度&lt;br&gt;安全 mux → /cmd_vel → 底盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1550" y="800" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="vlm" value="外部 VLM 服务&lt;br&gt;输入：指令 / 图像 / 结构化上下文&lt;br&gt;输出：解析 / 匹配 / 视觉判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeaf6;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
