        <mxCell id="prior" value="可选：先验 / 历史记忆&lt;br&gt;输入：已加载地图 + 坐标对齐&lt;br&gt;输出：候选与搜索上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeaf6;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;dashed=1;" vertex="1" parent="1">
