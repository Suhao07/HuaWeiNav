  <diagram id="1" name="02 模块输入输出与代码依据">
    <mxGraphModel dx="2100" dy="1550" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2100" pageHeight="1550" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="实物模块接口表｜数据、控制与验收边界&lt;br&gt;输入输出以代码契约为准；主题名称采用默认配置，具体设备使用 launch 参数映射。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0ebf5;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=28;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="2050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="th0" value="模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cbddec;strokeColor=#8ca0b4;fontColor=#19344a;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
