<mxfile host="app.diagrams.net" modified="2026-08-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="d435i-ros-control-node-graph" name="D435i ROS Control Node Graph">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Orin-26 D435i ROS 节点关系与控制发布框架（控制路径为设计态，未启用）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1500" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="lane_sensor" value="传感器与定位节点" style="swimlane;html=1;rounded=1;horizontal=0;startSize=32;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="620" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="lane_perception" value="检测与语义建图节点" style="swimlane;html=1;rounded=1;horizontal=0;startSize=32;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="560" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="lane_control" value="控制发布与底盘链路（需 controller contract 批准）" style="swimlane;html=1;rounded=1;horizontal=0;startSize=32;fillColor=#fef2f2;strokeColor=#dc2626;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1540" height="360" as="geometry"/>
        </mxCell>

        <mxCell id="camera_node" value="/camera/d435i&lt;br&gt;realsense2_camera&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;D435i 驱动节点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_sensor">
          <mxGeometry x="35" y="65" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="livox_node" value="/livox_lidar_publisher&lt;br&gt;livox_ros_driver2_node&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MID-360 驱动节点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_sensor">
          <mxGeometry x="35" y="205" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="lio_node" value="/laserMapping&lt;br&gt;pointlio_mapping&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Point-LIO 定位与点云&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_sensor">
          <mxGeometry x="350" y="205" width="230" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="tf_node" value="TF / frame 关系&lt;br&gt;camera_init → aft_mapped → base&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/tf + /tf_static&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;dashed=1;" vertex="1" parent="lane_sensor">
          <mxGeometry x="350" y="365" width="230" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="det_node" value="/detection_node&lt;br&gt;semantic_mapping/detection_node&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;YOLOE；图像节流/过期帧门控&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_perception">
          <mxGeometry x="35" y="65" width="245" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="map_node" value="/d435i_body_semantic_mapping&lt;br&gt;semantic_mapping_node&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;body 点云 + 检测 + 位姿融合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_perception">
          <mxGeometry x="310" y="250" width="245" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="runtime_node" value="STRIVE instruction_runtime_node&lt;br&gt;SysNavSemanticMapBridge&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;对象图 → NavigationIntent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="lane_perception">
          <mxGeometry x="310" y="405" width="245" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="waypoint_pub" value="STRIVE RosWaypointController&lt;br&gt;发布节点&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;设计：发布 /way_point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="45" y="75" width="245" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="adapter_node" value="/strive_waypoint_adapter&lt;br&gt;waypoint_adapter_node&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PointStamped → Float32MultiArray&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="365" y="75" width="265" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="pd_node" value="外部 Urban-Nav PD / local planner&lt;br&gt;外部所有节点&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/waypoint → /cmd_vel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="705" y="75" width="265" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="bridge_node" value="AgileX / Navflow bridge&lt;br&gt;velocity mux&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/cmd_vel → /navflow_cmd_vel → /base_cmd_vel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="1035" y="75" width="265" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="base_node" value="底盘控制器 / chassis&lt;br&gt;最终执行层&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;所有权、限速、急停待批准&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="1350" y="75" width="150" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="feedback_node" value="反馈/安全监控&lt;br&gt;/topoplan/reached_goal&lt;br&gt;/odom + 急停（待确认）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#7c2d12;dashed=1;" vertex="1" parent="lane_control">
          <mxGeometry x="705" y="220" width="265" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="cmd_forbidden" value="安全门禁&lt;br&gt;/cmd_vel 不由 STRIVE 直接发布&lt;br&gt;contract 未批准时禁止 handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="lane_control">
          <mxGeometry x="1035" y="220" width="465" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="e_cam_det" value="/camera/d435i/color/image_raw&lt;br&gt;sensor_msgs/Image" edge="1" parent="1" source="camera_node" target="det_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#2563eb;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_livox_lio" value="/livox/lidar + /livox/imu" edge="1" parent="1" source="livox_node" target="lio_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#16a34a;fontColor=#166534;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_lio_map" value="/cloud_registered_body&lt;br&gt;sensor_msgs/PointCloud2" edge="1" parent="1" source="lio_node" target="map_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#16a34a;fontColor=#166534;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_odom_map" value="/aft_mapped_to_init&lt;br&gt;nav_msgs/Odometry" edge="1" parent="1" source="lio_node" target="map_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#16a34a;fontColor=#166534;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_det_map" value="/huawei_vln/d435i_detection_result&lt;br&gt;tare_planner/msg/DetectionResult" edge="1" parent="1" source="det_node" target="map_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#d97706;fontColor=#92400e;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_map_runtime" value="/huawei_vln/d435i_body_object_nodes_list&lt;br&gt;tare_planner/msg/ObjectNodeList" edge="1" parent="1" source="map_node" target="runtime_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#d97706;fontColor=#92400e;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_runtime_pub" value="NavigationIntent / MotionGoal" edge="1" parent="1" source="runtime_node" target="waypoint_pub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#dc2626;fontColor=#991b1b;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_pub_adapter" value="/way_point&lt;br&gt;geometry_msgs/PointStamped&lt;br&gt;frame=map（设计约定）" edge="1" parent="1" source="waypoint_pub" target="adapter_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#dc2626;fontColor=#991b1b;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_adapter_pd" value="/waypoint&lt;br&gt;std_msgs/Float32MultiArray&lt;br&gt;data=[x_ego,y_ego]" edge="1" parent="1" source="adapter_node" target="pd_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#dc2626;fontColor=#991b1b;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_pd_bridge" value="/cmd_vel&lt;br&gt;geometry_msgs/Twist" edge="1" parent="1" source="pd_node" target="bridge_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#dc2626;fontColor=#991b1b;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_bridge_base" value="/navflow_cmd_vel → /base_cmd_vel&lt;br&gt;geometry_msgs/Twist" edge="1" parent="1" source="bridge_node" target="base_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#dc2626;fontColor=#991b1b;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_feedback_runtime" value="/topoplan/reached_goal&lt;br&gt;std_msgs/Bool（已观察 true；其他状态待确认）" edge="1" parent="1" source="feedback_node" target="runtime_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#ea580c;fontColor=#9a3412;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_base_feedback" value="/odom + blocked/timeout/急停状态（待底盘所有者确认）" edge="1" parent="1" source="base_node" target="feedback_node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#ea580c;fontColor=#9a3412;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="formula_proj" value="点云投影坐标变换（当前 D435i 配置）&lt;br&gt;&lt;br&gt;\(\displaystyle \mathbf{p}_{C}=\mathbf{R}_{L\to C}\left(\mathbf{R}_{B\to L}\mathbf{p}_{B}+\mathbf{t}_{B\to L}\right)+\mathbf{t}_{L\to C}\)&lt;br&gt;&lt;br&gt;\(\displaystyle \mathbf{R}_{B\to L}=\mathbf{R}(0,0,0),\quad \mathbf{t}_{B\to L}=\begin{bmatrix}0.011\\0.02329\\-0.04412\end{bmatrix}\,\mathrm{m}\)&lt;br&gt;\(\displaystyle \mathbf{t}_{L\to C}=\begin{bmatrix}0.10970761\\0.67284314\\0.27480904\end{bmatrix}\,\mathrm{m}\)&lt;br&gt;备注：外参状态 extrinsics_only，时间偏移仍未标定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="850" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="formula_odom" value="定位与 waypoint 坐标变换&lt;br&gt;&lt;br&gt;\(\displaystyle {}^{map}\!\mathbf{T}_{base}={}^{map}\!\mathbf{T}_{camera\_init}\,{}^{camera\_init}\!\mathbf{T}_{aft\_mapped}\,{}^{aft\_mapped}\!\mathbf{T}_{base}\)&lt;br&gt;&lt;br&gt;\(\displaystyle {}^{base}\!\mathbf{p}=\left({}^{map}\!\mathbf{R}_{base}\right)^{\!T}\left({}^{map}\!\mathbf{p}-{}^{map}\!\mathbf{t}_{base}\right)\)&lt;br&gt;&lt;br&gt;/aft_mapped_to_init 提供 camera_init→aft_mapped；/tf_static 提供 aft_mapped→base&lt;br&gt;必须先确认 map \(\equiv\) camera_init 或提供 \({}^{map}\!\mathbf{T}_{camera\_init}\)，不能静默假设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="1035" width="860" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="formula_adapter" value="Waypoint Adapter 坐标变换（ego_from_odom）&lt;br&gt;&lt;br&gt;\(\displaystyle \Delta\mathbf{p}=\begin{bmatrix}x_{wp}-x_{robot}\\y_{wp}-y_{robot}\end{bmatrix}\)&lt;br&gt;&lt;br&gt;\(\displaystyle \mathbf{p}_{ego}=\mathbf{R}_{z}(-\psi_{robot})\Delta\mathbf{p}=\begin{bmatrix}\cos\psi\,\Delta x+\sin\psi\,\Delta y\\-\sin\psi\,\Delta x+\cos\psi\,\Delta y\end{bmatrix}\)&lt;br&gt;&lt;br&gt;发布：\(\mathrm{Float32MultiArray.data}=[x_{ego},y_{ego}]\)；不发布 /cmd_vel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1">
          <mxGeometry x="930" y="1035" width="650" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="实线：已验证传感器/感知数据 topic；红色虚线：按当前框架设计的控制发布路径，须 controller contract 批准后才能启用；本图用于架构说明，不代表当前已发布控制指令。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1540" height="62" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
