# Offline-validated perception candidate; not an authorization to move.
# Inherit the sensor contract and all disabled control defaults.
if [[ -n "${ZSH_VERSION:-}" ]]; then
  WORLD_PROFILE_FILE="${(%):-%N}"
else
  WORLD_PROFILE_FILE="${BASH_SOURCE[0]}"
fi
source "$(dirname "${WORLD_PROFILE_FILE}")/orin26_livox_mid360_d435i.env"
unset WORLD_PROFILE_FILE

export ROBOT_PROFILE_NAME="orin26_livox_mid360_d435i_yoloworld_candidate"
export ROBOT_PROFILE_VERSION="2026-11-05-candidate"
export IMAGE_TAG="huawei-vln-realworld:orin-r36.5-yoloworld-candidate"
export CONTAINER_NAME="huawei-vln-realworld-d435i-yoloworld-candidate"
export SYSNAV_DETECTOR_MODEL_TYPE="yolo_world"
export SYSNAV_DETECTOR_MODEL_PATH="${SYSNAV_ASSET_DIR}/yolov8l-world.pt"
export SYSNAV_DETECTOR_IMGSZ="640"
