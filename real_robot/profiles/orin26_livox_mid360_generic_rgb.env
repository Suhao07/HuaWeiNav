# Orin-26 physical-robot profile.  This file contains no credentials and is
# intentionally safe for first bringup: it observes existing LIO only.
# Resolve the deployment root when this profile is sourced directly as well as
# through run_real_robot_profile.sh.  Hardware and model paths must never
# accidentally become /assets or another workspace's paths.
if [[ -z "${REPO_ROOT:-}" ]]; then
  export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi

export ROBOT_PROFILE_NAME="orin26_livox_mid360_generic_rgb"
export ROBOT_PROFILE_VERSION="2026-08-11"

# Isolated Docker resources.  Do not reuse the previous huawei-nav-real name.
export IMAGE_TAG="huawei-vln-realworld:orin-r36.5"
export CONTAINER_NAME="huawei-vln-realworld"
export RESTART_POLICY="no"
export INSTALL_ML_DEPS="1"
export INSTALL_LLM_DEPS="1"
# Read-only, robot-proven Jetson ROS/ML layers.  The new image COPY step still
# replaces the application code and never mounts the old workspace.
export REAL_ROBOT_BASE_IMAGE="huawei-nav-real:orin"
export SKIP_BASE_DEPS="1"

# ROS 2 transport must match the active host Point-LIO graph.  The container
# subscribes to these topics but never owns or restarts their publishers.
export ROS_DOMAIN_ID="0"
export ROS_LOCALHOST_ONLY="0"
export FASTDDS_BUILTIN_TRANSPORTS="UDPv4"
# The previous value is container-specific.  Host-side LIO diagnostics retain
# the external Point-LIO default transport unless a future robot overrides it.
export HOST_FASTDDS_BUILTIN_TRANSPORTS=""
export START_LIO="0"
export MANAGE_HOST_LIO="false"
export CLOUD_TOPIC="/cloud_registered"
export ODOM_TOPIC="/aft_mapped_to_init"
export STRIVE_POINTCLOUD_TOPIC="/cloud_registered"
export STRIVE_ODOM_TOPIC="/aft_mapped_to_init"
export STRIVE_PATH_TOPIC="/path"
# Read-only DDS diagnostic bindings.  These are used only by the bounded
# lio-diagnostics profile command; they do not manage the external LIO stack.
export LIO_LIDAR_TOPIC="/livox/lidar"
export LIO_IMU_TOPIC="/livox/imu"
export POINT_LIO_NODE_NAME="/laserMapping"
export LIO_DIAGNOSTIC_TIMEOUT_S="8"

# Generic UVC RGB camera.  The stable by-id path is documented and checked by
# the profile helper; /dev/video0 is used inside the container when enabled.
export CAMERA_EXPECTED_HOST_PATH="/dev/v4l/by-id/usb-Generic_USB_Camera_200901010001-video-index0"
export START_USB_CAM="false"
export USB_VIDEO_DEVICE="/dev/video0"
export USB_IMAGE_WIDTH="1280"
export USB_IMAGE_HEIGHT="720"
export USB_PIXEL_FORMAT="yuyv"
# This UVC camera advertises 1280x720 YUYV at 10 FPS; request the supported
# rate explicitly instead of relying on usb_cam's 30 FPS default.
export USB_FRAMERATE="10.0"
# Leave empty until RGB intrinsics are calibrated.  Then set a container-side
# URL such as file:///workspace/STRIVE/real_robot/calibration/orin26_rgb.yaml.
# docker_en.sh mounts this workspace-local directory read-only.
export USB_CAMERA_INFO_URL=""
export CAMERA_TOPIC="/camera/image"
export STRIVE_IMAGE_TOPIC="/camera/image"

# D435i depth is optional.  Its current adapter has no active source topic, so
# it is deliberately disabled until the RealSense driver and calibration pass.
export STRIVE_DEPTH_TOPIC=""
export REAL_ROBOT_EXTRA_DEVICES=""

# Keep SysNav output private to this deployment.  Existing LIO topics remain
# global because they are read-only sensor inputs from the host.
export DETECTION_TOPIC="/huawei_vln/detection_result"
export OBJECT_NODES_TOPIC="/huawei_vln/object_nodes_list"
export STRIVE_DETECTION_TOPIC="/huawei_vln/detection_result"
export STRIVE_OBJECT_TOPIC="/huawei_vln/object_nodes_list"
export STRIVE_ROOM_TOPIC="/huawei_vln/room_nodes_list"

# The template has deliberately unapproved calibration values.  Mapping stays
# disabled until an approved, robot-specific projection asset replaces it.
export MAPPING_CONFIG="/workspace/STRIVE/real_robot/ros2_ws/src/semantic_mapping/config/mapping_orin26_livox_generic_rgb.yaml"
export PROJECTION_CONFIG="/workspace/STRIVE/real_robot/ros2_ws/src/semantic_mapping/config/projection_orin26_generic_rgb_template.yaml"
export START_SEMANTIC_MAPPING="false"
# Detector-only may start without a live point cloud.  A calibrated fusion
# profile must switch both gates to true; the helper refuses mapping otherwise.
export WAIT_FOR_LIO="0"
export REQUIRE_LIO_SAMPLE="0"
export LIO_SAMPLE_TIMEOUT_S="5"

# Assets are private to this workspace and mounted read-only into the container.
export SYSNAV_ASSET_DIR="${REPO_ROOT}/assets"
export SYSNAV_DETECTOR_MODEL_TYPE="yoloe"
export SYSNAV_DETECTOR_MODEL_PATH="${SYSNAV_ASSET_DIR}/yoloe-11s-seg.pt"
export SYSNAV_SAM2_CHECKPOINT="${SYSNAV_ASSET_DIR}/sam2.1_hiera_base_plus.pt"
export SYSNAV_MOBILECLIP_BLT_PATH="${SYSNAV_ASSET_DIR}/mobileclip_blt.pt"
export SYSNAV_MOBILECLIP_BLT_TS_PATH="${SYSNAV_ASSET_DIR}/mobileclip_blt.ts"
export SYSNAV_CLIP_VIT_B32_PATH="${SYSNAV_ASSET_DIR}/ViT-B-32.pt"

# High-level runtime is opt-in and locked to dry-run.  It cannot issue a real
# motion goal until all three later safety gates are explicitly opened.
export START_STRIVE_RUNTIME="0"
export STRIVE_DRY_RUN="true"
export STRIVE_LOWER_CONTROLLER_ENABLED="false"
export BLOCK_LOWER_CONTROLLER="1"
export ENABLE_LOWER_CONTROLLER="0"
export ALLOW_REAL_MOTION="false"
# Must remain empty until an externally reviewed, robot-specific controller
# contract is placed in real_robot/control/.  The runtime rejects live motion
# without that contract even if the other switches are changed.
export CONTROL_CONTRACT_FILE=""
export STRIVE_WAYPOINT_TOPIC="/way_point"
export STRIVE_TEST_WAYPOINT_TOPIC="/huawei_vln/test_way_point"
export STRIVE_POLICY_MODE="wait"
export STRIVE_INSTRUCTION_PLAN_BACKEND="rules"
export STRIVE_RUN_DIRECTORY="/workspace/STRIVE/output/runtime"

# Bounded smoke defaults.  The first smoke does not open camera hardware or
# initialize the detector model; each can be enabled after its prior gate.
export CHECK_CAMERA="0"
export CHECK_DETECTOR_INIT="0"
export REQUIRE_LIO="1"
export REQUIRE_ML="1"
export REQUIRE_ASSETS="1"
export RUNTIME_SMOKE_DURATION_S="8"
