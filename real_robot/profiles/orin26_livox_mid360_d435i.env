# Orin-26 Livox MID-360 + Intel RealSense D435i profile.
# Host-owned Livox/Point-LIO and RealSense drivers are observed through ROS 2;
# this profile never starts or modifies either external driver.
# Resolve from the profile file itself.  A relative ``source`` invocation can
# otherwise resolve against the caller's working directory and point model
# paths at /home/assets instead of this workspace.
if [[ -z "${REPO_ROOT:-}" || ! -d "${REPO_ROOT}/assets" ]]; then
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    PROFILE_FILE="${(%):-%N}"
  else
    PROFILE_FILE="${BASH_SOURCE[0]}"
  fi
  PROFILE_DIR="$(cd "$(dirname "${PROFILE_FILE}")" && pwd)"
  export REPO_ROOT="$(cd "${PROFILE_DIR}/../.." && pwd)"
fi

export ROBOT_PROFILE_NAME="orin26_livox_mid360_d435i"
export ROBOT_PROFILE_VERSION="2026-08-13"
export IMAGE_TAG="huawei-vln-realworld:orin-r36.5"
export CONTAINER_NAME="huawei-vln-realworld-d435i"
export RESTART_POLICY="no"
export REAL_ROBOT_BASE_IMAGE="huawei-nav-real:orin"
export SKIP_BASE_DEPS="1"

export ROS_DOMAIN_ID="0"
export ROS_LOCALHOST_ONLY="0"
export FASTDDS_BUILTIN_TRANSPORTS="UDPv4"
export HOST_FASTDDS_BUILTIN_TRANSPORTS=""
export START_LIO="0"
export MANAGE_HOST_LIO="false"
 # Use the body-frame cloud for all project preflight and mapping checks.
 # The full /cloud_registered stream is intentionally not subscribed here:
 # it is a high-bandwidth diagnostic output that can starve Point-LIO.
export CLOUD_TOPIC="/cloud_registered_body"
export ODOM_TOPIC="/aft_mapped_to_init"
export STRIVE_POINTCLOUD_TOPIC="/cloud_registered_body"
export STRIVE_ODOM_TOPIC="/aft_mapped_to_init"
export LIO_LIDAR_TOPIC="/livox/lidar"
export LIO_IMU_TOPIC="/livox/imu"
export POINT_LIO_NODE_NAME="/laserMapping"
export LIO_DIAGNOSTIC_TIMEOUT_S="8"

# D435i is owned by the host RealSense ROS driver.  The container subscribes
# to its RGB stream and does not pass any USB device through to Docker.
export START_USB_CAM="false"
export USB_VIDEO_DEVICE="/dev/video0"
export USB_IMAGE_WIDTH="1280"
export USB_IMAGE_HEIGHT="720"
export USB_PIXEL_FORMAT="yuyv"
export USB_FRAMERATE="30.0"
export CAMERA_TOPIC="/camera/d435i/color/image_raw"
export STRIVE_IMAGE_TOPIC="/camera/d435i/color/image_raw"
export STRIVE_DEPTH_TOPIC="/camera/d435i/aligned_depth_to_color/image_raw"
# The current ARM64 image still expects a non-empty optional launch argument.
# START_USB_CAM=false means this file is not read by the D435i path; the live
# D435i CameraInfo topic remains authoritative.
export USB_CAMERA_INFO_URL="file:///workspace/STRIVE/real_robot/calibration/camera_x001_intrinsics.yaml"

export DETECTION_TOPIC="/huawei_vln/d435i_detection_result"
export OBJECT_NODES_TOPIC="/huawei_vln/d435i_object_nodes_list"
export STRIVE_DETECTION_TOPIC="/huawei_vln/d435i_detection_result"
export STRIVE_OBJECT_TOPIC="/huawei_vln/d435i_object_nodes_list"
export STRIVE_ROOM_TOPIC="/huawei_vln/d435i_room_nodes_list"

# The D435i/MID-360 projection asset is still extrinsics_only.  Keep mapping
# disabled until RGB-LiDAR time offset and reprojection validation are approved.
export MAPPING_CONFIG="/workspace/STRIVE/real_robot/ros2_ws/src/semantic_mapping/config/mapping_orin26_d435i_mid360.yaml"
export PROJECTION_CONFIG="/workspace/STRIVE/real_robot/ros2_ws/src/semantic_mapping/config/projection_orin26_d435i_mid360.yaml"
export START_SEMANTIC_MAPPING="false"
export WAIT_FOR_LIO="1"
export REQUIRE_LIO_SAMPLE="1"
export LIO_SAMPLE_TIMEOUT_S="5"

export SYSNAV_ASSET_DIR="${REPO_ROOT}/assets"
export SYSNAV_DETECTOR_MODEL_TYPE="yoloe"
export SYSNAV_DETECTOR_MODEL_PATH="${SYSNAV_ASSET_DIR}/yoloe-11s-seg.pt"
export SYSNAV_DETECTOR_DEVICE="cuda:0"
export SYSNAV_DETECTOR_IMGSZ="320"
export SYSNAV_SAM2_CHECKPOINT="${SYSNAV_ASSET_DIR}/sam2.1_hiera_base_plus.pt"
export SYSNAV_MOBILECLIP_BLT_PATH="${SYSNAV_ASSET_DIR}/mobileclip_blt.pt"
export SYSNAV_MOBILECLIP_BLT_TS_PATH="${SYSNAV_ASSET_DIR}/mobileclip_blt.ts"
export SYSNAV_CLIP_VIT_B32_PATH="${SYSNAV_ASSET_DIR}/ViT-B-32.pt"
# Keep semantic mapping from consuming all host executor threads; Point-LIO is
# host-owned and must retain scheduling headroom on Orin-26.
export SYSNAV_MAPPING_EXECUTOR_THREADS="1"

# High-level runtime, waypoint adapter, lower controller and real motion are
# all disabled.  These values are mandatory safe defaults for this profile.
export START_STRIVE_RUNTIME="0"
export STRIVE_DRY_RUN="true"
export STRIVE_LOWER_CONTROLLER_ENABLED="false"
export BLOCK_LOWER_CONTROLLER="1"
export ENABLE_LOWER_CONTROLLER="0"
export ALLOW_REAL_MOTION="false"
export CONTROL_CONTRACT_FILE=""
export START_WAYPOINT_ADAPTER="false"
export WAYPOINT_ADAPTER_CONFIG="/workspace/STRIVE/real_robot/control/orin26_waypoint_adapter.yaml"
export WAYPOINT_ADAPTER_INPUT_TOPIC="/way_point"
export WAYPOINT_ADAPTER_OUTPUT_TOPIC="/waypoint"
export WAYPOINT_ADAPTER_ODOM_TOPIC="/aft_mapped_to_init"
export WAYPOINT_ADAPTER_OUTPUT_ENABLED="false"
export STRIVE_POLICY_MODE="wait"
export STRIVE_INSTRUCTION_PLAN_BACKEND="rules"
export STRIVE_RUN_DIRECTORY="/workspace/STRIVE/output/runtime"

export REQUIRE_ASSETS="1"
export REQUIRE_LIO="1"
export REQUIRE_ML="1"
export CHECK_CAMERA="0"
export CHECK_DETECTOR_INIT="0"
