<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>strive_sysnav_motion</name>
  <version>0.1.0</version>
  <description>Task-level SysNav waypoint motion server for STRIVE.</description>
  <maintainer email="devnull@example.com">STRIVE Real Robot Integration</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>strive_motion_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
