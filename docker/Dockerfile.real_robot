ARG REAL_ROBOT_BASE_IMAGE=ros:humble-ros-base
FROM ${REAL_ROBOT_BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG INSTALL_ML_DEPS=0
ARG INSTALL_LLM_DEPS=1
ARG UBUNTU_PORTS_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
ARG JETSON_PYTORCH_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG SKIP_BASE_DEPS=0

SHELL ["/bin/bash", "-lc"]

ENV STRIVE_WS=/workspace/STRIVE
ENV STRIVE_REAL_ROBOT_WS=/workspace/STRIVE/real_robot/ros2_ws
ENV PYTHONPATH=/workspace/STRIVE

RUN if [[ "${SKIP_BASE_DEPS}" != "1" ]]; then set -euo pipefail; \
    for file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
      [[ -e "${file}" ]] || continue; \
      sed -i -E \
        -e "s#http://ports.ubuntu.com/ubuntu-ports/?#${UBUNTU_PORTS_MIRROR}#g" \
        -e "s#http://ports.ubuntu.com/?#${UBUNTU_PORTS_MIRROR}#g" \
        "${file}"; \
    done; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
      > /etc/apt/apt.conf.d/80-strive-retries; \
    grep -R "${UBUNTU_PORTS_MIRROR}" /etc/apt/sources.list /etc/apt/sources.list.d || true; fi

RUN if [[ "${SKIP_BASE_DEPS}" != "1" ]]; then apt-get update \
 && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-pip \
      python3-opencv \
      python3-yaml \
      ros-humble-cv-bridge \
      ros-humble-pcl-conversions \
      ros-humble-pcl-ros \
      ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-ros \
 && rm -rf /var/lib/apt/lists/*; fi

RUN if [[ "${SKIP_BASE_DEPS}" != "1" ]]; then apt-get update \
 && apt-get install -y --no-install-recommends \
      ros-humble-topic-tools \
      ros-humble-usb-cam \
      v4l-utils \
 && rm -rf /var/lib/apt/lists/*; fi

RUN if [[ "${SKIP_BASE_DEPS}" != "1" && "${INSTALL_LLM_DEPS}" == "1" ]]; then \
      python3 -m pip install --no-cache-dir \
        "pydantic>=2,<3" openai ; \
    fi

# JetPack 6.2 does not use the generic x86 PyPI PyTorch wheels.  Keep the
# Jetson index explicit and install all detector/mapping dependencies in this
# image, rather than inheriting an opaque host Python environment.
RUN if [[ "${SKIP_BASE_DEPS}" != "1" && "${INSTALL_ML_DEPS}" == "1" ]]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends \
        build-essential git libjpeg-dev libopenblas-dev libpng-dev ninja-build python3-dev zlib1g-dev \
      && rm -rf /var/lib/apt/lists/* \
      && python3 -m pip install --no-cache-dir --upgrade "pip<26" "setuptools<80" wheel \
      && python3 -m pip install --no-cache-dir "numpy<2" packaging \
      && python3 -m pip install --no-cache-dir --timeout 120 --retries 10 \
        --index-url "${JETSON_PYTORCH_INDEX}" torch torchvision \
      && python3 -m pip install --no-cache-dir \
        --timeout 120 --retries 10 --extra-index-url "${JETSON_PYTORCH_INDEX}" \
        pyyaml pillow scipy scikit-learn shapely hydra-core omegaconf iopath tqdm \
        "opencv-python==4.11.0.86" supervision ultralytics open3d "rerun-sdk==0.18.2" ; \
    fi

WORKDIR ${STRIVE_WS}

# Copy the full STRIVE source tree for single-container real-robot deployment.
# .dockerignore excludes HM3D data, logs, checkpoints, and ROS build products.
COPY . ${STRIVE_WS}

# 核心：实物镜像内同时包含 STRIVE 上层和 SysNav ROS overlay；
# 权重仍通过 volume/env 挂载，避免把大模型文件固化进镜像。
RUN source /opt/ros/humble/setup.bash \
 && cd ${STRIVE_REAL_ROBOT_WS} \
 && colcon build --symlink-install --packages-up-to \
      tare_planner terrain_analysis local_planner semantic_mapping \
      strive_motion_msgs strive_sysnav_motion strive_sysnav_bringup

RUN chmod +x ${STRIVE_WS}/scripts/build_real_robot_ros_ws.sh \
             ${STRIVE_WS}/scripts/check_real_robot_acceptance.sh \
             ${STRIVE_WS}/scripts/export_code_only.sh \
             ${STRIVE_WS}/scripts/run_sysnav_detection_mapping.sh \
             ${STRIVE_WS}/scripts/run_real_robot_bag_replay.sh \
             ${STRIVE_WS}/scripts/run_lower_planner_bag_replay.sh \
             ${STRIVE_WS}/scripts/generate_synthetic_lower_planner_bag.py \
             ${STRIVE_WS}/scripts/run_lower_planner_bag_smoke.sh \
             ${STRIVE_WS}/scripts/run_real_robot_instruction_runtime.sh \
             ${STRIVE_WS}/scripts/start_real_robot_framework.sh \
             ${STRIVE_WS}/scripts/start_orin_lio_for_strive.sh \
             ${STRIVE_WS}/scripts/smoke_real_robot_orin.sh \
             ${STRIVE_WS}/docker/run_real_robot_sysnav_stack.sh

CMD ["/bin/bash"]
