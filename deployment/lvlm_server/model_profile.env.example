# Copy this file outside Git and adjust it for the inference server.

MS_SWIFT_ROOT=/opt/vln/ms-swift
# VLN_LVLM_* is the preferred deployment configuration namespace. The
# STRIVE_LVLM_* names remain valid for existing deployment profiles.
VLN_LVLM_MODEL_PATH=/models/Qwen2.5-VL-7B-Instruct
VLN_LVLM_SERVED_MODEL=vln-qwen2.5-vl-7b
VLN_LVLM_HOST=0.0.0.0
VLN_LVLM_PORT=8000
VLN_LVLM_API_KEY=replace-with-a-private-token

# Qwen-VL image and vLLM resource bounds.
MAX_PIXELS=1003520
VIDEO_MAX_PIXELS=50176
FPS_MAX_FRAMES=12
VLN_LVLM_MAX_MODEL_LEN=8192
VLN_LVLM_MAX_NEW_TOKENS=1024
VLN_LVLM_GPU_MEMORY_UTILIZATION=0.85
VLN_LVLM_LIMIT_MM_PER_PROMPT={"image":8,"video":0}

# Low-memory alternative:
# VLN_LVLM_MODEL_PATH=/models/Qwen2.5-VL-3B-Instruct
# VLN_LVLM_SERVED_MODEL=vln-qwen2.5-vl-3b
