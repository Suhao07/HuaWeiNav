# Copy this file outside Git and adjust it for the inference server.

MS_SWIFT_ROOT=/opt/strive/ms-swift
# Preferred VLN aliases are accepted by run_server.sh. The STRIVE_LVLM_*
# names remain valid for existing deployment profiles.
STRIVE_LVLM_MODEL_PATH=/models/Qwen2.5-VL-7B-Instruct
STRIVE_LVLM_SERVED_MODEL=strive-qwen2.5-vl-7b
STRIVE_LVLM_HOST=0.0.0.0
STRIVE_LVLM_PORT=8000
STRIVE_LVLM_API_KEY=replace-with-a-private-token

# Qwen-VL image and vLLM resource bounds.
MAX_PIXELS=1003520
VIDEO_MAX_PIXELS=50176
FPS_MAX_FRAMES=12
STRIVE_LVLM_MAX_MODEL_LEN=8192
STRIVE_LVLM_MAX_NEW_TOKENS=1024
STRIVE_LVLM_GPU_MEMORY_UTILIZATION=0.85
STRIVE_LVLM_LIMIT_MM_PER_PROMPT={"image":8,"video":0}

# Low-memory alternative:
# STRIVE_LVLM_MODEL_PATH=/models/Qwen2.5-VL-3B-Instruct
# STRIVE_LVLM_SERVED_MODEL=strive-qwen2.5-vl-3b
